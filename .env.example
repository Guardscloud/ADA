# --- Yapay zekâ sağlayıcısı ---
# gemini    : Google Gemini, ÜCRETSİZ katman — anahtar: https://aistudio.google.com/apikey
# anthropic : Claude (en güçlü; API kredisi gerekir) — anahtar: https://console.anthropic.com
# selfhost  : kendi sunucunuz / bu Mac'teki açık model (vLLM, Ollama, LM Studio — OpenAI uyumlu)
# auto      : ANTHROPIC_API_KEY varsa Claude, yoksa Gemini
ADA_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini modelleri sırayla denenir; birinin ücretsiz kotası dolunca sonrakine geçilir
# ADA_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Qwen ŞİMDİLİK PASİF: yedek kapalıdır, ADA-AGI de Qwen modellerini kullanmaz. Açmak için:
# ADA_QWEN_ENABLED=true
# Qwen yedeği (ADA_PROVIDER=gemini iken). Öncelik Gemini'dedir; Gemini bir turu yapamazsa
# (kota dolu, sunucu yoğun, güvenlik filtresi, boş yanıt) aynı tur Qwen ile tamamlanır.
# Anahtar girilince kendiliğinden açılır — anahtar: https://modelstudio.console.alibabacloud.com
# ADA_QWEN_API_KEY=                               # veya DASHSCOPE_API_KEY
# ADA_QWEN_MODEL=qwen-plus
# ADA_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # Ollama'daki Qwen: http://localhost:11434/v1
# ADA_QWEN_VISION=false                           # qwen-vl-* modelinde true (ekran kontrolü ve görseller)
# ADA_QWEN_SCREEN_COORDS=pixel                    # Qwen3-VL için norm1000
# ADA_QWEN_TOOLSET=core                           # yerel adreste varsayılan core (~17 araç, küçük bağlam), bulutta full
# ADA_QWEN_FALLBACK=true                         # yedeği elle kapatmak için false

# Kendi sunucunuz (ADA_PROVIDER=selfhost)
# ADA_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; kiralık sunucu için SSH tüneli adresi
# ADA_LLM_API_KEY=
# ADA_LLM_MODEL=gpt-oss:20b
# ADA_LLM_VISION=false                          # model görsel okuyorsa true (ekran kontrolü açılır)

# --- Özerklik ---
# full  : hiçbir şey sormaz (yalnızca diski/sistemi yok eden macOS/Linux komutları her zaman engellenir)
# smart : yalnızca tehlikeli işlemlerde arayüzden onay ister (sudo, rm -r, e-posta gönderme, takvim, silme...)
# ask   : yan etkisi olan her işlemde onay ister
ADA_AUTONOMY=smart

# --- Rutinler (workspace/rutinler/*.md: her gün kendiliğinden yapılan işler) ---
# ADA_ROUTINE_DEFAULT_TIME=09:00   # dosyada saat yazmıyorsa
# ADA_ROUTINE_MAX_MINUTES=30       # bir rutin çalışmasının süre sınırı (dosyada "sure:" ile değiştirilebilir)
# ADA_ROUTINE_MAX_PARALLEL=2       # aynı anda en fazla kaç rutin çalışsın
# ADA_ROUTINE_KEEP_RUNS=30         # rutin başına saklanan çalışma geçmişi (eskilerin konuşmaları silinir, raporları kalır)
# ADA_NOTIFICATIONS=true           # masaüstü bildirimleri (rutin bitti, onay bekleniyor...)

# --- Claude Code motoru (ADA_PROVIDER=adaagi iken; API anahtarı gerekmez) ---
# Bu bilgisayarda Claude Code kuruluysa ve oturumu açıksa (claude → /login) ADA-AGI onu motor olarak kullanır.
# ADA_CLAUDE_CODE=true                    # kapatmak için false
# ADA_CLAUDE_CODE_MODELS=opus,sonnet,haiku
# ADA_CLAUDE_CODE_PATH=                   # claude komutunun tam yolu (boşsa ADA kendisi bulur)

# --- Claude ayarları (isteğe bağlı) ---
# ADA_MODEL=claude-opus-5-5
# ADA_EFFORT=high            # low | medium | high | xhigh | max
# ADA_MAX_STEPS=80           # bir görevde en fazla model turu
# ADA_SUBAGENT_MAX_STEPS=40

# --- Bilgisayar kontrolü (varsayılan hepsi açık) ---
# ADA_ENABLE_SHELL=true      # kabuk komutları, dosya sistemi, uygulama açma, AppleScript
# ADA_ENABLE_COMPUTER=true   # ekran görüntüsü + fare/klavye (macOS'ta Ekran Kaydı ve Erişilebilirlik izni gerekir)
# ADA_ENABLE_MAC_APPS=true   # Mail, Takvim, Anımsatıcılar, Notlar, Kişiler
# ADA_ENABLE_PYTHON=true
# ADA_SCREENSHOT_MAX_WIDTH=1280

# --- Web arayüzü ---
# ADA_HOST=127.0.0.1         # ağdaki diğer cihazlardan erişim için 0.0.0.0 (o zaman parola ZORUNLU)
# ADA_PORT=8000
# ADA_PASSWORD=              # boşsa giriş istenmez (yalnızca 127.0.0.1 için güvenlidir)

# --- E-posta, IMAP (Mac dışı sistemler için; Mac'te Mail.app zaten kullanılır) ---
# ADA_IMAP_HOST=imap.gmail.com
# ADA_IMAP_USER=ornek@gmail.com
# ADA_IMAP_PASSWORD=uygulama-sifresi
